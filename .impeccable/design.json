      "html": "<nav class=\"ds-nav\" aria-label=\"Portfolio\"><a href=\"#home\" aria-current=\"page\">Home</a><a href=\"#about\">About</a><a href=\"#projects\">Projects</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:3px}.ds-nav a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 12px;color:var(--muted,#69656a);font-family:var(--font-body,sans-serif);font-size:12px;border-radius:5px;text-decoration:none}.ds-nav a[aria-current=\"page\"]{color:var(--foreground,#28272b);background:var(--selected,#e8dfd1)}.ds-nav a:hover{color:var(--foreground,#28272b)}.ds-nav a:focus-visible{outline:2px solid var(--accent,#9b693f);outline-offset:5px}",
