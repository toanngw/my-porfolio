  "narrative": {
    "northStar": "Snowlight Studio",
    "overview": "Snowlight Studio is a quiet winter workspace: an original miniature timber alcove, warm lamp, laptop, shoji frame, and snowy pine sit beside compact portfolio content. The scene supplies the material character; charcoal and ivory interface surfaces keep professional evidence easy to read.\n\nThe persistent workspace accompanies six hash-linked views. Local typography, a transparent portrait, restrained controls, and subtle ambient movement make the setting personal without replacing the CV-backed work.",
    "keyCharacteristics": [
      "Persistent original procedural workspace with a matching static fallback.",
      "Neutral dark and ivory light themes with warm accents.",
      "Compact content, quiet separators, and small rounded controls.",
      "Ambient motion follows reduced motion by default; explicit Play/Pause overrides the ambient preference, and hidden tabs suspend rendering."
    ],
    "rules": [
      {
        "name": "The Warm Accent Rule",
        "body": "Use the accent for small identity marks, focus, selected timeline nodes, and contact emphasis; keep the large interface surfaces neutral.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use DM Sans for the home identity and interface; use Lora for view titles and the studio signature.",
        "section": "typography"
      },
      {
        "name": "The Scene Owns Depth Rule",
        "body": "Let the workspace carry dimensionality; keep content containers quiet and avoid adding floating card shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the six hash-linked views and persistent workspace.",
      "Do keep interactive controls at least 44px high and provide visible keyboard focus.",
      "Do preserve both themes, local fonts, and the supplied portrait identity.",
      "Do stop ambient animation loops for user pause or hidden tabs; respect reduced motion by default and allow explicit user opt-in."
    ],
    "donts": [
      "Don't replace the original scene with borrowed reference-site assets or code.",
      "Don't add saturated interface surfaces or decorative card shadows.",
      "Don't turn project diagrams into screenshots or imply unverified outcomes."
    ]
  }
}
